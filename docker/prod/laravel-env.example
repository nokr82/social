# 운영 서버의 social/api/.env
#   cp docker/prod/laravel-env.example api/.env  → 빈 값 채우기 (DEPLOY.md 2단계)
APP_NAME=소셜링
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://social.devhong.shop
APP_LOCALE=ko
APP_FALLBACK_LOCALE=ko

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

# 컨테이너 이름으로 접속 (docker-compose.prod.yml), 값은 social/.env와 같게
DB_CONNECTION=mariadb
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=social
DB_USERNAME=social
DB_PASSWORD=

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
CACHE_STORE=redis
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=reverb

# 웹소켓: 서버 → reverb 컨테이너(내부), 브라우저 → 도메인 443 (빌드 시 social/.env의 값이 들어감)
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# 사진: Lightsail 버킷(S3 호환, 비공개). 버킷 > 권한 > 액세스 키 만들기
PHOTO_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-northeast-2
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ── 소셜링앱 ──────────────────────────────────────
# 개발 서버 값과 다르게 새로 생성 (`openssl rand -hex 32`). 운영 시작 후 절대 변경 금지
CI_PEPPER=
SOCIAL_LOGIN_DRIVER=real
# 비공개 베타: 직접 입력(self). PASS 계약 후 pass
IDENTITY_DRIVER=self
PRESENCE_DRIVER=redis
REGION_DRIVER=kakao

# 카카오 디벨로퍼스 > 내 애플리케이션 > 앱 키 > REST API 키 (로그인·동네 찾기 공용)
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=https://social.devhong.shop/auth/kakao

# 웹 푸시: 개발 서버 키와 별도로 `php artisan webpush:vapid --show`로 생성
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# 관리자 화면(/admin) 접근 허용 IP (쉼표 구분, 비우면 제한 없음 — 로그인만으로 보호)
ADMIN_ALLOWED_IPS=
