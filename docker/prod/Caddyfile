# Caddy: 도메인만 적으면 Let's Encrypt 인증서를 자동 발급·갱신 (80·443 포트가 열려 있어야 함)
{$APP_DOMAIN} {
	root * /var/www/public
	encode zstd gzip

	# 사진 업로드 상한 (PHP post_max_size와 맞춤)
	request_body {
		max_size 25MB
	}

	# 웹소켓(Reverb): /app/{key} 연결, /apps/... 이벤트 API
	@reverb path /app/* /apps/*
	reverse_proxy @reverb reverb:8080

	# 빌드 파일은 이름에 해시가 있어 1년 캐시, 서비스 워커는 항상 새로 확인
	header /build/* Cache-Control "public, max-age=31536000, immutable"
	header /sw.js Cache-Control "no-cache"

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(self)"
		-Server
	}

	# 파일이 있으면 그대로, 없으면 index.php(Laravel) — SPA 화면 주소도 Laravel이 app 화면을 돌려줌
	php_fastcgi php:9000
	file_server
}
